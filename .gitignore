# ======================
# 项目特定忽略 (PyTorch/深度学习)
# ======================

# 模型文件
*.pth
*.pt
*.ckpt
*.h5
*.hdf5
*.onnx
*.pb
saved_models/
checkpoints/
# 模型输出目录（根目录和常见子目录）
/models/
experiments/models/
!src/models/          # 源代码目录例外：不忽略

# 训练结果和输出
results/
logs/
runs/                  # PyTorch Lightning/TensorBoard 默认日志目录
lightning_logs/
tensorboard/
wandb/                 # Weights & Biases 本地目录
/figures/              # 仅排除根目录的figures
!/paper/figures/       # 但允许paper/figures
output/
outputs/               # Hydra 默认输出目录

# 数据集相关
data/cache/
data/processed/
data/raw/
datasets/
*.npy                  # NumPy 数组
*.npz                  # 压缩的 NumPy 数组

