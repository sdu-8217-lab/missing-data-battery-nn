# 全局排除（但允许paper目录下的png）
*.json
*.xdv
*.png

# 实验生成的 YAML 文件（Hydra 输出目录）
outputs/**/*.yaml
outputs/**/*.yml

# 根目录 YAML 文件默认排除（按需添加例外）
/*.yaml
/*.yml
!environment.yml

# 允许特定目录的 YAML
!configs/**/*.yaml
!configs/**/*.yml
!paper/**/*.png
!paper/**/*.html
!paper/**/*.yaml
!paper/**/*.yml

# ======================
# 项目特定忽略 (PyTorch/深度学习)
# ======================

# 模型文件
*.pth
*.pt
*.ckpt
*.h5
*.onnx
*.pb
saved_models/
checkpoints/
# 模型输出目录（根目录和常见子目录）
/models/
experiments/models/
!src/models/          # 源代码目录例外：不忽略

# 训练结果和输出
results/
logs/
runs/                  # PyTorch Lightning/TensorBoard 默认日志目录
lightning_logs/
tensorboard/
wandb/                 # Weights & Biases 本地目录
/figures/              # 仅排除根目录的figures
!/paper/figures/       # 但允许paper/figures
output/
outputs/               # Hydra 默认输出目录

# 数据集相关
data/cache/
data/processed/
data/raw/
datasets/
*.npy                  # NumPy 数组
*.npz                  # 压缩的 NumPy 数组
*.hdf5
*.h5

# ======================
# 临时文件和目录
# ======================

tmp_legacy/            # 旧代码备份
22602_140541/          # 临时实验目录
tmp_*.py               # 临时脚本
*_backup_*.csv         # 备份文件
# 临时问题分析文件
PROBLEM_ANALYSIS.txt
QUICK_FIX_INSTRUCTIONS.md

# ======================
# 开发环境
# ======================

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Jupyter
.ipynb_checkpoints
*.ipynb

# PyCharm
.idea/
*.iml

# LaTeX (新增规则)
*.aux
*.bbl
*.blg
*.dvi
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.synctex.gz
*.pdf
*.ps
*.eps

# ======================
# Python 通用忽略规则
# ======================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
virtualenv/

# C extensions and build artifacts
*.so
*.pyd
*.dll
*.pyc
*.pyo
build/
dist/
*.egg-info/
*.whl

# Coverage reports
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
htmlcov/
.pytest_cache/

# IDE and editor files
.DS_Store
.Thumbs.db
*.swp
*.swo
*~
.env
wandb/
