# ======================
# 项目特定忽略 (PyTorch/深度学习)
# ======================

# 先定义例外：保留关键文件（必须在忽略规则之前）
# 注意：所有例外规则在文件末尾的"重新声明例外规则"部分统一声明
# 以确保在全局忽略规则（如*.yaml）之后生效

# 忽略旧的hydra配置系统（根目录）
/configs/
!.github/**/*.yml              # GitHub Actions

# 模型文件
*.pth
*.pt
*.ckpt
*.h5
*.hdf5
*.onnx
*.pb
saved_models/
checkpoints/
# 模型输出目录（根目录和常见子目录）
/models/
experiments/models/

# 训练结果和输出
results/
logs/
runs/                  # PyTorch Lightning/TensorBoard 默认日志目录
lightning_logs/
tensorboard/
wandb/                 # Weights & Biases 本地目录
/figures/              # 仅排除根目录的figures
!/paper/figures/       # 但允许paper/figures
output/
outputs/               # Hydra 默认输出目录

# 实验输出目录（包含大量时间戳子目录）
experiments/2C/
experiments/3C/
experiments/R2.5/
experiments/R3/
experiments/RW/
experiments/Sim_satellite/
experiments_v2/
experiments_v3/

# experiments_new 实验框架输出
experiments_new/results/*/
!experiments_new/results/.gitkeep
experiments_new/outputs/*/
!experiments_new/outputs/.gitkeep
experiments_new/**/__pycache__/
experiments_new/**/*.pyc
experiments_new/**/*.pyo
experiments_new/**/*.log
experiments_new/**/nohup.out
experiments_new/**/*.pt
experiments_new/**/*.pth
experiments_new/**/test_results.csv
experiments_new/**/train_results.csv
experiments_new/**/eval.log
experiments_new/**/train.log
experiments_new/**/run_*.log

# 数据集相关
data/cache/
data/processed/
data/raw/
datasets/
*.npy                  # NumPy 数组
*.npz                  # 压缩的 NumPy 数组
*.pkl                  # Python pickle 文件
*.pickle               # Python pickle 文件（备用扩展名）

# ======================
# 临时文件和目录
# ======================

# 旧代码备份和临时目录
tmp_legacy/            # 旧代码备份
.rework/               # 重构工作目录
.imputation_cache/     # 插补缓存
battery_experiment_reproduce*  # 老代码压缩包及解压目录
cleanup_backup_*/      # 清理备份

# 临时问题分析文件
PROBLEM_ANALYSIS.txt
QUICK_FIX_INSTRUCTIONS.md

# 奇怪的临时文件
=2.14.0
*.Zone.Identifier

