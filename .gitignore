# ======================
# 项目特定规则
# ======================

# 全局排除（但允许特定目录）
*.json
*.png

# YAML 文件 - 保留关键配置，其他忽略
# 注意：例外规则已在前面的"先定义例外"部分声明

# 然后定义忽略规则（仅对未被例外的文件生效）
*.yaml
*.yml

# 重新声明例外规则以确保生效（针对YAML）
!environment.yml
!pyproject.toml
!model_configs.yaml
# 保留实验框架配置
!experiments_new/configs/**
# 但忽略自动生成的批量配置（例外规则之后）
experiments_new/configs/experiments/batch_configs/
experiments_new/configs/experiments/batch_configs_*/
experiments_new/configs/experiments/batch_configs_fast/
!paper/**/*.yaml
!paper/**/*.yml
!.pre-commit-config.yaml
!**/.github/**/*.yml         # GitHub Actions
!MODEL_ARCHITECTURE_DESIGN.md  # 模型设计文档
!model_architecture_design.py  # 模型设计脚本

# 仅排除根目录的 figures，但允许 paper/figures
/figures/
!/paper/figures/

# 审稿人可验证的实验结果数据（例外规则必须在results/之后）
!results/xjtu_2c/
!results/xjtu_2c/20260308_023704_summary.csv
!results/xjtu_2c/20260308_023704_raw_data.csv

# 论文图表（带时间戳）
!paper/figures/20260308_023704/
!paper/figures/20260308_023704/*.png

# 归档文件
archive/
.cleanup_backup/

# === 奥卡姆剃刀清理 - 自动忽略 ===
# Python缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 实验日志和输出
lightning_logs/
experiments/logs/
experiments/runs/
*.log

# 测试模型（保留核心模型目录）
models/test_*
models/debug_*
models/compare_*
models/strategy_*

# 备份和临时
.cleanup_backup/
