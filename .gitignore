# ======================
# 项目特定规则
# ======================

# 全局排除（但允许特定目录）
*.json
*.png

# 根目录 YAML 排除（按需添加例外）
/*.yaml
/*.yml
!environment.yml

# 允许特定目录的文件
!configs/**/*.yaml
!configs/**/*.yml
!paper/**/*.png
!paper/**/*.html
!paper/**/*.yaml
!paper/**/*.yml

# 仅排除根目录的 figures，但允许 paper/figures
/figures/
!/paper/figures/

# 审稿人可验证的实验结果数据（例外规则必须在results/之后）
!results/xjtu_2c/
!results/xjtu_2c/20260308_023704_summary.csv
!results/xjtu_2c/20260308_023704_raw_data.csv

