# ======================
# 项目特定规则
# ======================

# 全局排除（但允许特定目录）
*.json
*.png

# YAML 文件默认全部忽略，只有明确规定的才保留
**/*.yaml
**/*.yml

# 例外：保留关键配置
!environment.yml               # 根目录环境配置
!configs/**/*.yaml             # Hydra 配置文件
!configs/**/*.yml
!paper/**/*.yaml               # 论文相关配置
!paper/**/*.yml
!paper/**/*.png                # 论文图表

# 仅排除根目录的 figures，但允许 paper/figures
/figures/
!/paper/figures/

# 审稿人可验证的实验结果数据（例外规则必须在results/之后）
!results/xjtu_2c/
!results/xjtu_2c/20260308_023704_summary.csv
!results/xjtu_2c/20260308_023704_raw_data.csv

# 论文图表（带时间戳）
!paper/figures/20260308_023704/
!paper/figures/20260308_023704/*.png

# 归档文件
archive/
.cleanup_backup/

# === 奥卡姆剃刀清理 - 自动忽略 ===
# Python缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 实验日志和输出
lightning_logs/
experiments/logs/
experiments/runs/
*.log

# 测试模型（保留核心模型目录）
models/test_*
models/debug_*
models/compare_*
models/strategy_*

# 备份和临时
.cleanup_backup/
