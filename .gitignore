# ======================
# 项目特定规则
# ======================

# 全局排除（但允许特定目录）
*.json
*.png

# 根目录 YAML 排除（按需添加例外）
/*.yaml
/*.yml
!environment.yml

# 允许特定目录的文件
!configs/**/*.yaml
!configs/**/*.yml
!paper/**/*.png
!paper/**/*.html
!paper/**/*.yaml
!paper/**/*.yml
!paper/experiment_data/**/*.json

# 仅排除根目录的 figures，但允许 paper/figures
/figures/
!/paper/figures/
